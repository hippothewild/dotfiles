#!/usr/bin/env python3
"""cmux notification hook: replace the generic agent notification title
("Claude Code", "Codex", ...) with the sidebar workspace's own title (falling
back to the project directory name), so macOS Notification Center shows which
session needs attention instead of a title every session shares.

Registered in cmux.json under notifications.hooks. Reads the notification
policy JSON on stdin and writes the (possibly modified) policy JSON back on
stdout, per https://github.com/manaflow-ai/cmux/blob/main/docs/notifications.md.
On any parse/lookup failure this exits without writing valid JSON, which
cmux treats as "use default notification behavior" — never worth erroring
loudly over a cosmetic rename.

Python 3 stdlib only.
"""

import json
import os
import re
import shutil
import subprocess
import sys

CMUX_FALLBACK = "/Applications/cmux.app/Contents/Resources/bin/cmux"
TIMEOUT = 5


def cmux_bin():
    return shutil.which("cmux") or CMUX_FALLBACK


def lookup_workspace_title(workspace_id):
    if not workspace_id:
        return None
    try:
        proc = subprocess.run(
            [cmux_bin(), "rpc", "extension.sidebar.snapshot", "{}"],
            capture_output=True,
            text=True,
            timeout=TIMEOUT,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if proc.returncode != 0:
        return None
    try:
        snap = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    for w in snap.get("workspaces", []):
        if w.get("id") == workspace_id:
            title = w.get("title")
            if not title:
                return None
            # Strip the leading git-status glyph cmux prefixes onto the
            # auto-generated conversational title (e.g. "⠂ fix the thing").
            return re.sub(r"^[^\w]+\s*", "", title).strip() or None
    return None


def main():
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(1)

    notification = payload.get("notification", {})
    context = payload.get("context", {})

    session_name = lookup_workspace_title(notification.get("workspaceId"))
    if not session_name:
        cwd = context.get("cwd")
        session_name = os.path.basename(cwd.rstrip("/")) if cwd else None

    if session_name:
        notification["title"] = session_name
        payload["notification"] = notification

    json.dump(payload, sys.stdout)


if __name__ == "__main__":
    main()
