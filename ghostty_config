# Font configuration
font-family = Hack
font-size = 21
# Pin Hangul to D2Coding so cmux's CJK font-codepoint-map auto-injection
# (which force-maps Korean to Apple SD Gothic Neo) doesn't silently change on app update.
# SF Mono / Hack have no Hangul glyphs; D2Coding is a Korean coding monospace.
# Ranges: Hangul Syllables, Jamo, Compatibility Jamo, Jamo Extended-A/B.
font-codepoint-map = U+AC00-U+D7A3,U+1100-U+11FF,U+3130-U+318F,U+A960-U+A97F,U+D7B0-U+D7FF=D2Coding
font-feature = -calt
font-feature = -clig
font-feature = -liga
adjust-cell-height = 15%
adjust-cell-width = -10%

# Colors (muted earthy variant of Tomorrow Night — matches statusline tones)
background = 1d1f21
foreground = c5c8c6

# ANSI colors
palette = 0=#1d1f21
palette = 1=#c98a8a
palette = 2=#b0ad8b
palette = 3=#d6b898
palette = 4=#a1b2bc
palette = 5=#b09bb8
palette = 6=#9cb8b3
palette = 7=#d8d8d2

# Bright colors
palette = 8=#4a4d52
palette = 9=#c98a8a
palette = 10=#b0ad8b
palette = 11=#d6b898
palette = 12=#a1b2bc
palette = 13=#b09bb8
palette = 14=#9cb8b3
palette = 15=#e8e8e2

# Cursor
cursor-color = c5c8c6
cursor-text = 1d1f21
cursor-style = block
cursor-style-blink = false

# Selection
selection-background = 373b41
selection-foreground = c5c8c6

# Window
macos-titlebar-style = native
background-opacity = 0.92
window-padding-x = 4
window-padding-y = 4
macos-window-shadow = true

# Scrollback
scrollback-limit = 50000

# Keybindings - Split panes
keybind = cmd+m=new_split:down
keybind = cmd+l=new_split:right
keybind = cmd+[=goto_split:previous
keybind = cmd+]=goto_split:next

# Keybindings - Line navigation
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05

# Keybindings - Word navigation
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf

# Keybindings - Word deletion
keybind = alt+backspace=text:\x17

# Splits
unfocused-split-opacity = 0.85
split-divider-color = #3e4451
